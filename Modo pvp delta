-- Tamanho real da tela (onde o overlay desenha)
local function ScreenSize()
local abs = OverlayGui.AbsoluteSize
if abs.X < 50 or abs.Y < 50 then
local cam = workspace.CurrentCamera
return cam and cam.ViewportSize or Screen
end
return abs
end
-- Diferença entre a tela inteira e a área da câmera (bordas/notch)
local function ScreenOffset()
if not Settings.AutoAlign then
return V2(0, 0)
end
local cam = workspace.CurrentCamera
local abs = OverlayGui.AbsoluteSize
if not cam or abs.X < 50 or abs.Y < 50 then
return V2(0, 0)
end
local view = cam.ViewportSize
return V2(
math.clamp((abs.X - view.X) / 2, -150, 150),
math.clamp((abs.Y - view.Y) / 2, -150, 150)
)
end
-- Mundo -> coordenadas do overlay (já alinhadas com a tela real)
local function W2S(cam, position, extra)
local p = cam:WorldToViewportPoint(position)
local o = ScreenOffset()
return V3(
p.X + o.X + (extra and extra.X or 0),
p.Y + o.Y + (extra and extra.Y or 0),
p.Z
)
end
local function MakeDraggable(handle, target, onClick, keepInside)
local dragging = false
local moved = false
local dragStart
local startPos
local startCenter
Connect(handle.InputBegan, function(input)
if input.UserInputType == UIT.MouseButton1
or input.UserInputType == UIT.Touch then
dragging = true
moved = false
dragStart = V2(input.Position.X, input.Position.Y)
startPos = target.Position
startCenter = target.AbsolutePosition + target.AbsoluteSize * 0.5
local ended
ended = input.Changed:Connect(function()
if input.UserInputState == Enum.UserInputState.End then
ended:Disconnect()
dragging = false
if not moved and onClick then
onClick()
end
end
end)
end
end)
Connect(UserInputService.InputChanged, function(input)
if not dragging then
return
end
if input.UserInputType == UIT.MouseMovement
or input.UserInputType == UIT.Touch then
local delta = V2(input.Position.X, input.Position.Y) - dragStart
if not moved and delta.Magnitude < 6 then
return
end
moved = true
if keepInside then
local view = Camera.ViewportSize
local size = target.AbsoluteSize
local center = startCenter + delta
local cx = math.clamp(center.X, size.X / 2, math.max(view.X - size.X / 2, size.X / 2))
local cy = math.clamp(center.Y, size.Y / 2, math.max(view.Y - size.Y / 2, size.Y / 2))
target.Position = UO(cx, cy)
else
target.Position = U2(
startPos.X.Scale, startPos.X.Offset + delta.X,
startPos.Y.Scale, startPos.Y.Offset + delta.Y
)
end
end
end)
end
