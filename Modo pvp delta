local function FovCenter()
local screen = ScreenSize()
return V2(screen.X * A.PosX / 100, screen.Y * A.PosY / 100)
end
-- Arrastar o círculo do FOV direto na tela
local fovDragging = false
local fovDragStart = V2(0, 0)
local fovDragOrigin = V2(0, 0)
Connect(FovDrag.InputBegan, function(input)
if input.UserInputType == UIT.MouseButton1
or input.UserInputType == UIT.Touch then
fovDragging = true
fovDragStart = V2(input.Position.X, input.Position.Y)
fovDragOrigin = FovCenter()
local ended
ended = input.Changed:Connect(function()
if input.UserInputState == Enum.UserInputState.End then
ended:Disconnect()
fovDragging = false
end
end)
end
end)
Connect(UserInputService.InputChanged, function(input)
if not fovDragging then
return
end
if input.UserInputType == UIT.MouseMovement
or input.UserInputType == UIT.Touch then
local delta = V2(input.Position.X, input.Position.Y) - fovDragStart
local screen = ScreenSize()
local nx = math.clamp(fovDragOrigin.X + delta.X, 0, screen.X)
local ny = math.clamp(fovDragOrigin.Y + delta.Y, 0, screen.Y)
if SetPosX and SetPosY then
SetPosX(nx / screen.X * 100)
SetPosY(ny / screen.Y * 100)
end
end
end)
local function GetAimPart(character)
if A.Part == "Cabeça" then
return character:FindFirstChild("Head")
end
return character:FindFirstChild("UpperTorso")
or character:FindFirstChild("Torso")
or character:FindFirstChild("HumanoidRootPart")
end
local function IsVisible(part, character)
local cam = workspace.CurrentCamera
local params = RaycastParams.new()
params.FilterType = Enum.RaycastFilterType.Exclude
params.FilterDescendantsInstances = { Player.Character, character }
params.IgnoreWater = true
local origin = cam.CFrame.Position
return workspace:Raycast(origin, part.Position - origin, params) == nil
end
-- Só escolhe alvos DENTRO do círculo do FOV
local function GetTarget(cam, center)
local off = ScreenOffset()
local best
local bestDistance = A.FOV
for _, other in ipairs(Players:GetPlayers()) do
local character = other ~= Player and other.Character
if character then
local humanoid = character:FindFirstChildOfClass("Humanoid")
local part = GetAimPart(character)
if humanoid and humanoid.Health > 0 and part then
local point, onScreen = cam:WorldToViewportPoint(part.Position)
if onScreen then
local screenPoint = V2(point.X + off.X, point.Y + off.Y)
local distance = (screenPoint - center).Magnitude
if distance < bestDistance and (A.IgnoreWalls or IsVisible(part, character)) then
best = part
bestDistance = distance
end
end
end
end
end
return best
end
local bindName = "AngelPvPAimbot"
RunService:BindToRenderStep(bindName, Enum.RenderPriority.Camera.Value + 1, function(dt)
local cam = workspace.CurrentCamera
if not cam then
return
end
local center = FovCenter()
FovCircle.Visible = (A.Enabled and A.ShowFOV) or A.DragMode
FovCircle.Size = UO(A.FOV * 2, A.FOV * 2)
FovCircle.Position = UO(center.X, center.Y)
FovCircle.BackgroundTransparency = A.DragMode and 0.88 or 1
FovDrag.Visible = A.DragMode
if not A.Enabled then
return
end
if A.HoldRMB and UserInputService.MouseEnabled
and not UserInputService:IsMouseButtonPressed(UIT.MouseButton2) then
return
end
local target = GetTarget(cam, center)
if not target then
return
end
-- Gira a câmera para o alvo ficar exatamente no centro do FOV (mira da arma)
local origin = cam.CFrame.Position
local off = ScreenOffset()
local viewPoint = center - V2(off.X, off.Y)
local aimRay = cam:ViewportPointToRay(viewPoint.X, viewPoint.Y).Direction
local toTarget = (target.Position - origin).Unit
local look = cam.CFrame.LookVector
local axis = aimRay:Cross(toTarget)
local angle = 0
if axis.Magnitude > 1e-5 then
angle = math.acos(math.clamp(aimRay:Dot(toTarget), -1, 1))
look = CFrame.fromAxisAngle(axis.Unit, angle):VectorToWorldSpace(look)
end
-- Longe: o alvo é pequeno e qualquer erro de mira vira "fora". Reduz a suavidade com a distância
local distance = (target.Position - origin).Magnitude
local farBoost = math.clamp((distance - 40) / 120, 0, 1) -- 0 perto ... 1 longe (160+ studs)
local smooth = (A.Smooth / 100) * (1 - 0.9 * farBoost)
local alpha = 1 - smooth * 0.98
alpha = 1 - (1 - alpha) ^ (math.clamp(dt, 0, 0.1) * 60)
-- Erro pequeno: trava exato no alvo (sem sobra de suavização)
if angle < 0.01 then
alpha = 1
end
local goal = CFrame.lookAt(origin, origin + look)
cam.CFrame = cam.CFrame:Lerp(goal, math.clamp(alpha, 0, 1))
end)
