object.Holo:Destroy()
object.Holo = nil
end
object.Holder:Destroy()
end
local function UpdateObject(other, object, cam, screen)
local character = other.Character
local root = character and character:FindFirstChild("HumanoidRootPart")
local humanoid = character and character:FindFirstChildOfClass("Humanoid")
if not (E.Enabled and root and humanoid and humanoid.Health > 0) then
HideObject(object)
return
end
SetHolo(object, character, E.Hologram)
local extra = V2(E.OffX, E.OffY)
local rootPoint = W2S(cam, root.Position, extra)
if rootPoint.Z <= 0 then
HideDrawings(object)
return
end
local topPoint = W2S(cam, root.Position + V3(0, 2.9, 0), extra)
local bottomPoint = W2S(cam, root.Position - V3(0, 3.2, 0), extra)
local height = math.max(bottomPoint.Y - topPoint.Y, 4)
local width = height * 0.58
local left = rootPoint.X - width / 2
if E.Box then
object.Box.Position = UO(left, topPoint.Y)
object.Box.Size = UO(width, height)
object.Box.Visible = true
else
object.Box.Visible = false
end
if E.Health then
local ratio = math.clamp(humanoid.Health / math.max(humanoid.MaxHealth, 1), 0, 1)
object.HealthBack.Position = UO(left - 6, topPoint.Y)
object.HealthBack.Size = UO(3, height)
object.HealthFill.Size = US(1, ratio)
object.HealthFill.BackgroundColor3 = RGB(255, 80, 90):Lerp(RGB(80, 255, 140), ratio)
object.HealthBack.Visible = true
else
object.HealthBack.Visible = false
end
if E.Name or E.Distance then
local text = ""
if E.Name then
text = other.DisplayName
end
if E.Distance then
local distance = math.floor((cam.CFrame.Position - root.Position).Magnitude + 0.5)
text = (text ~= "" and (text .. " ") or "") .. "[" .. distance .. "]"
end
object.Name.Text = text
object.Name.Position = UO(rootPoint.X, topPoint.Y - 2)
object.Name.Visible = true
else
object.Name.Visible = false
end
if E.Tracers then
SetLine(object.Tracer, V2(screen.X / 2, screen.Y), V2(rootPoint.X, rootPoint.Y), 1.2)
else
object.Tracer.Visible = false
end
local pairsList = (humanoid.RigType == Enum.HumanoidRigType.R15) and R15 or R6
for i, bone in ipairs(object.Bones) do
local drawn = false
local pair = pairsList[i]
if E.Skeleton and pair then
local partA = character:FindFirstChild(pair[1])
local partB = character:FindFirstChild(pair[2])
if partA and partB then
local pa = W2S(cam, partA.Position, extra)
local pb = W2S(cam, partB.Position, extra)
if pa.Z > 0 and pb.Z > 0 then
SetLine(bone, V2(pa.X, pa.Y), V2(pb.X, pb.Y), 1.5)
drawn = true
end
end
end
if not drawn then
bone.Visible = false
end
end
end
