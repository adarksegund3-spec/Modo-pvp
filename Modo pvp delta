-- Holograma: preenchimento colorido visível através das paredes
local function SetHolo(object, character, on)
local hl = object.Holo
if on and character then
if not hl or hl.Parent ~= character then
if hl then
hl:Destroy()
end
hl = Instance.new("Highlight")
hl.Name = "AngelHolo"
hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
hl.Adornee = character
hl.Parent = character
object.Holo = hl
end
hl.FillColor = E.HoloColor
hl.OutlineColor = E.HoloColor:Lerp(WHITE, 0.35)
hl.FillTransparency = E.HoloTransparency
hl.OutlineTransparency = 0.05
hl.Enabled = true
elseif hl then
hl.Enabled = false
end
end
