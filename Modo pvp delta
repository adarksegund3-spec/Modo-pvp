local Pages = {}
local TabButtons = {}
local ActiveTab = 0
local function SelectTab(index)
if index == ActiveTab then
return
end
ActiveTab = index
for i, page in ipairs(Pages) do
page.Visible = (i == index)
end
for i, button in ipairs(TabButtons) do
Tween(button, 0.25, { TextColor3 = (i == index) and WHITE or Theme.Muted })
end
Tween(Indicator, 0.35, {
Position = U2(TabStarts[index], 6, 1, -2),
Size = U2(TabWeights[index], -12, 0, 2),
}, ES.Quint, ED.Out)
local page = Pages[index]
page.Position = UO(0, 14)
Tween(page, 0.35, { Position = UO(0, 0) }, ES.Quint, ED.Out)
end
for i, name in ipairs(TabNames) do
local button = Create("TextButton", {
Name = "Tab" .. i,
Position = US(TabStarts[i], 0),
Size = US(TabWeights[i], 1),
BackgroundTransparency = 1,
Text = name,
TextColor3 = Theme.Muted,
TextSize = 12,
TextScaled = true,
TextWrapped = false,
Font = BODY_BOLD,
AutoButtonColor = false,
ZIndex = 12,
}, TabBar)
Create("UITextSizeConstraint", { MaxTextSize = 12, MinTextSize = 7 }, button)
Create("UIPadding", { PaddingLeft = UD(0, 4), PaddingRight = UD(0, 4) }, button)
Connect(button.MouseEnter, function()
if ActiveTab ~= i then
Tween(button, 0.15, { TextColor3 = LAVENDER })
end
end)
Connect(button.MouseLeave, function()
if ActiveTab ~= i then
Tween(button, 0.2, { TextColor3 = Theme.Muted })
end
end)
Connect(button.MouseButton1Click, function()
SelectTab(i)
end)
table.insert(TabButtons, button)
table.insert(Pages, CreatePage())
end
