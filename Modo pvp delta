local function Tween(object, duration, properties, style, direction, delayTime)
local animation = TweenService:Create(
object,
TweenInfo.new(
duration,
style or ES.Sine,
direction or ED.InOut,
0,
false,
delayTime or 0
),
properties
)
animation:Play()
return animation
end
local function Create(className, properties, parent)
